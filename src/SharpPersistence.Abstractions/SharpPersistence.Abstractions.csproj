<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>2.1.0</Version>
        <Title>SharpPersistence.Abstractions</Title>
        <PackageTags>sql database repository generic-repository unit-of-work check-constraint</PackageTags>
        <NoWarn>CS1591</NoWarn>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>SharpPersistence.Abstractions contains the Dependencies for SharpPersistence</Description>
    </PropertyGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\SharpPersistence.Abstractions.Generators\SharpPersistence.Abstractions.Generators.csproj"
                          PrivateAssets="All"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\SharpPersistence.Abstractions.Generators\bin\$(Configuration)\netstandard2.0\SharpPersistence.Abstractions.Generators.dll"
              Pack="true"
              PackagePath="analyzers\dotnet\cs"
              Visible="false" />
        <None Include="buildTransitive\SharpPersistence.Abstractions.props"
              Pack="true"
              PackagePath="buildTransitive\SharpPersistence.Abstractions.props"
              Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\skills\sharp-persistence-abstractions\**\*">
            <Pack>True</Pack>
            <Link>skills\sharp-persistence-abstractions\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <PackagePath>skills\sharp-persistence-abstractions\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
        </None>
    </ItemGroup>

</Project>
