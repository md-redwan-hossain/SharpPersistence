<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>2.1.0</Version>
        <Title>SharpPersistence</Title>
        <PackageTags>sql database repository generic-repository unit-of-work check-constraint</PackageTags>
        <NoWarn>CS1591</NoWarn>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>SharpPersistence is a collection of robust, extensible, and thoroughly tested .NET libraries for working with database systems.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Humanizer" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\skills\sharp-persistence\**\*">
            <Pack>True</Pack>
            <Link>skills\sharp-persistence\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <PackagePath>skills\sharp-persistence\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Update="buildTransitive\SharpPersistence.props"
              Pack="True"
              PackagePath="buildTransitive\SharpPersistence.props"
              Visible="false" />
        <None Update="buildTransitive\SharpPersistence.targets"
              Pack="True"
              PackagePath="buildTransitive\SharpPersistence.targets"
              Visible="false" />
        <None Include="..\SharpPersistence.Generators\bin\$(Configuration)\netstandard2.0\SharpPersistence.Generators.dll"
              Pack="True"
              PackagePath="analyzers/dotnet/cs"
              Visible="false" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharpPersistence.Abstractions\SharpPersistence.Abstractions.csproj" />
        <ProjectReference Include="..\SharpPersistence.Generators\SharpPersistence.Generators.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="Analyzer"
                          PrivateAssets="all" />
    </ItemGroup>

</Project>
