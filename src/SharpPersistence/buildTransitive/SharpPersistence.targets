<Project>
  <PropertyGroup>
    <SharpPersistenceAutoCopySqlFiles Condition="'$(SharpPersistenceAutoCopySqlFiles)' == ''">true</SharpPersistenceAutoCopySqlFiles>
    <SharpPersistenceGenerateSqlExtensions Condition="'$(SharpPersistenceGenerateSqlExtensions)' == ''">true</SharpPersistenceGenerateSqlExtensions>
    <SharpPersistenceSqlOutputFolder Condition="'$(SharpPersistenceSqlOutputFolder)' == ''">sharp_persistence_sql_files</SharpPersistenceSqlOutputFolder>
  </PropertyGroup>

  <Target Name="_SharpPersistenceDiscoverSqlFiles"
          BeforeTargets="AssignTargetPaths;BeforeCompile;CollectUpToDateCheckInputDesignTime"
          Condition="'$(SharpPersistenceAutoCopySqlFiles)' == 'true' Or '$(SharpPersistenceGenerateSqlExtensions)' == 'true'">
    <ItemGroup>
      <_SharpPersistenceSqlRunlistFiles Include="$(MSBuildProjectDirectory)\**\db-migration-runlist.json"
                                        Exclude="$(MSBuildProjectDirectory)\bin\**;$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\out\**;$(MSBuildProjectDirectory)\publish\**" />
    </ItemGroup>

    <ItemGroup Condition="'@(_SharpPersistenceSqlRunlistFiles)' != ''">
      <_SharpPersistenceSqlRunlistDirs Include="$([MSBuild]::NormalizeDirectory($([System.IO.Path]::GetDirectoryName('%(_SharpPersistenceSqlRunlistFiles.FullPath)'))))" />
      <_SharpPersistenceSqlMigrationExcludes Include="%(_SharpPersistenceSqlRunlistDirs.Identity)**\*.sql" />
    </ItemGroup>

    <ItemGroup>
      <_SharpPersistenceSqlDiscovered Include="**\*.sql"
                                      Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder);out\**;publish\**;bin\**;obj\**;MigrationScripts\**;@(EmbeddedResource);$(SharpPersistenceSqlExclude)" />
      <_SharpPersistenceSqlDiscovered Remove="@(_SharpPersistenceSqlMigrationExcludes)" />
    </ItemGroup>

    <ItemGroup Condition="'$(SharpPersistenceAutoCopySqlFiles)' == 'true' And '@(_SharpPersistenceSqlDiscovered)' != ''">
      <_SharpPersistenceSqlCustomItems Include="@(Content)" Condition="'%(Content.TargetPath)' != ''" />
      <_SharpPersistenceSqlCustomItems Include="@(None)" Condition="'%(None.TargetPath)' != ''" />
      <_SharpPersistenceSqlCopyFiles Include="@(_SharpPersistenceSqlDiscovered)" />
      <_SharpPersistenceSqlCopyFiles Remove="@(_SharpPersistenceSqlCustomItems)" />

      <Content Remove="@(_SharpPersistenceSqlCopyFiles)" />
      <None Remove="@(_SharpPersistenceSqlCopyFiles)" />
      <None Include="@(_SharpPersistenceSqlCopyFiles)"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest"
            TargetPath="$(SharpPersistenceSqlOutputFolder)\$(AssemblyName)\%(_SharpPersistenceSqlCopyFiles.RecursiveDir)%(_SharpPersistenceSqlCopyFiles.Filename)%(_SharpPersistenceSqlCopyFiles.Extension)" />
      <UpToDateCheckInput Include="@(_SharpPersistenceSqlCopyFiles)" Set="SharpPersistenceSql" />
    </ItemGroup>

    <ItemGroup Condition="'$(SharpPersistenceGenerateSqlExtensions)' == 'true' And '@(_SharpPersistenceSqlDiscovered)' != ''">
      <AdditionalFiles Remove="@(_SharpPersistenceSqlDiscovered)" />
      <AdditionalFiles Include="@(_SharpPersistenceSqlDiscovered)" />
    </ItemGroup>
  </Target>
</Project>
