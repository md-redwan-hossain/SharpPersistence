<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>1.0.0</Version>
        <Title>SharpPersistence.Migrator</Title>
        <Authors>Md. Redwan Hossain</Authors>
        <Copyright>Copyright (c) Md. Redwan Hossain</Copyright>
        <PackageProjectUrl>https://github.com/md-redwan-hossain/SharpPersistence</PackageProjectUrl>
        <PackageIcon>logo.png</PackageIcon>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/md-redwan-hossain/SharpPersistence</RepositoryUrl>
        <PackageTags>sql database migration ddl schema-diff postgresql oracle</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <NoWarn>CS1591</NoWarn>
        <DocumentationFile Condition="'$(Configuration)'=='Release'">bin\$(Configuration)\$(TargetFramework)\SharpPersistence.Migrator.xml</DocumentationFile>
        <Description>Reflection-based, DI-first schema diffing, idempotent DDL generation, and C#-first database migration runner for PostgreSQL and Oracle.</Description>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharpPersistence.Migrator.Cli" />
        <InternalsVisibleTo Include="SharpPersistence.Migrator.EfCore" />
        <InternalsVisibleTo Include="SharpPersistence.Migrator.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Humanizer" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\logo.png">
            <Pack>True</Pack>
            <PackagePath>.</PackagePath>
            <Link>logo.png</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <Link>README.md</Link>
            <PackagePath>.</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharpPersistence\SharpPersistence.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Update="buildTransitive\SharpPersistence.Migrator.props"
              Pack="true"
              PackagePath="buildTransitive\SharpPersistence.Migrator.props"
              Visible="false" />
        <None Update="buildTransitive\SharpPersistence.Migrator.targets"
              Pack="true"
              PackagePath="buildTransitive\SharpPersistence.Migrator.targets"
              Visible="false" />
    </ItemGroup>

</Project>
