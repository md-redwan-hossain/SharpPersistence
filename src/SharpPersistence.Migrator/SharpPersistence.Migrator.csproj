<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>1.0.0</Version>
        <Title>SharpPersistence.Migrator</Title>
        <PackageTags>sql database migration ddl schema-diff postgresql oracle</PackageTags>
        <NoWarn>CS1591</NoWarn>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Description>Reflection-based, DI-first schema diffing, idempotent DDL generation, and C#-first database migration runner for PostgreSQL and Oracle.</Description>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharpPersistence.Migrator.Cli" />
        <InternalsVisibleTo Include="SharpPersistence.Migrator.EfCore" />
        <InternalsVisibleTo Include="SharpPersistence.Migrator.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Humanizer" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\skills\sharp-persistence-migrator\**\*">
            <Pack>True</Pack>
            <Link>skills\sharp-persistence-migrator\%(RecursiveDir)%(Filename)%(Extension)</Link>
            <PackagePath>skills\sharp-persistence-migrator\%(RecursiveDir)%(Filename)%(Extension)</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharpPersistence\SharpPersistence.csproj" />
        <ProjectReference Include="..\SharpPersistence.Migrator.Generators\SharpPersistence.Migrator.Generators.csproj"
                          ReferenceOutputAssembly="false"
                          OutputItemType="Analyzer"
                          PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <None Update="buildTransitive\SharpPersistence.Migrator.props"
              Pack="true"
              PackagePath="buildTransitive\SharpPersistence.Migrator.props"
              Visible="false" />
        <None Update="buildTransitive\SharpPersistence.Migrator.targets"
              Pack="true"
              PackagePath="buildTransitive\SharpPersistence.Migrator.targets"
              Visible="false" />
    </ItemGroup>

</Project>
