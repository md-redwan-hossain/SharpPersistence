<Project>
  <PropertyGroup>
    <SharpPersistenceAutoCopyMigrationScripts Condition="'$(SharpPersistenceAutoCopyMigrationScripts)' == ''">true</SharpPersistenceAutoCopyMigrationScripts>
  </PropertyGroup>

  <Target Name="_SharpPersistenceIncludeMigrationScripts"
          BeforeTargets="AssignTargetPaths;CollectUpToDateCheckInputDesignTime"
          Condition="'$(SharpPersistenceAutoCopyMigrationScripts)' == 'true'">
    <ItemGroup>
      <_SharpPersistenceRunlistFiles Include="$(MSBuildProjectDirectory)\**\db-migration-runlist.json"
                                     Exclude="$(MSBuildProjectDirectory)\bin\**;$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\out\**;$(MSBuildProjectDirectory)\publish\**" />
    </ItemGroup>

    <ItemGroup Condition="'@(_SharpPersistenceRunlistFiles)' != ''">
      <_SharpPersistenceMigrationsDirs Include="$([MSBuild]::NormalizeDirectory($([System.IO.Path]::GetDirectoryName('%(_SharpPersistenceRunlistFiles.FullPath)'))))" />
    </ItemGroup>

    <ItemGroup Condition="'@(_SharpPersistenceMigrationsDirs)' == '' And Exists('$(MSBuildProjectDirectory)\MigrationScripts')">
      <_SharpPersistenceMigrationsDirs Include="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)\MigrationScripts'))" />
    </ItemGroup>

    <ItemGroup Condition="'@(_SharpPersistenceMigrationsDirs)' != ''">
      <_SharpPersistenceMigrationAssets Include="%(_SharpPersistenceMigrationsDirs.Identity)**\*.sql"
                                        Exclude="$(MSBuildProjectDirectory)\bin\**;$(MSBuildProjectDirectory)\obj\**;$(MSBuildProjectDirectory)\out\**;$(MSBuildProjectDirectory)\publish\**" />
      <_SharpPersistenceMigrationAssets Include="%(_SharpPersistenceMigrationsDirs.Identity)db-migration-runlist*.json" />
    </ItemGroup>

    <ItemGroup Condition="'@(_SharpPersistenceMigrationAssets)' != ''">
      <Content Remove="@(_SharpPersistenceMigrationAssets)" />
      <None Remove="@(_SharpPersistenceMigrationAssets)" />
      <None Include="@(_SharpPersistenceMigrationAssets)"
            TargetPath="$([MSBuild]::MakeRelative($(MSBuildProjectDirectory), %(_SharpPersistenceMigrationAssets.FullPath)))"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
      <UpToDateCheckInput Include="@(_SharpPersistenceMigrationAssets)" Set="SharpPersistenceMigrations" />
    </ItemGroup>
  </Target>
</Project>
