<Project>
  <PropertyGroup>
    <SharpPersistenceAutoCopyMigrationScripts Condition="'$(SharpPersistenceAutoCopyMigrationScripts)' == ''">true</SharpPersistenceAutoCopyMigrationScripts>
  </PropertyGroup>

  <Target Name="_SharpPersistenceIncludeMigrationScripts"
          BeforeTargets="AssignTargetPaths;CollectUpToDateCheckInputDesignTime"
          Condition="'$(SharpPersistenceAutoCopyMigrationScripts)' == 'true' And Exists('$(MSBuildProjectDirectory)\DbMigrator\Scripts')">
    <ItemGroup>
      <_SharpPersistenceMigrationAssets Include="$(MSBuildProjectDirectory)\DbMigrator\Scripts\**\*.sql"
                                        Exclude="$(MSBuildProjectDirectory)\DbMigrator\Scripts\bin\**;$(MSBuildProjectDirectory)\DbMigrator\Scripts\obj\**" />
      <_SharpPersistenceMigrationAssets Include="$(MSBuildProjectDirectory)\DbMigrator\Scripts\db-migration-runlist*.json" />
    </ItemGroup>

    <ItemGroup Condition="'@(_SharpPersistenceMigrationAssets)' != ''">
      <Content Remove="@(_SharpPersistenceMigrationAssets)" />
      <None Remove="@(_SharpPersistenceMigrationAssets)" />
      <None Include="@(_SharpPersistenceMigrationAssets)"
            TargetPath="$([MSBuild]::MakeRelative($(MSBuildProjectDirectory), %(_SharpPersistenceMigrationAssets.FullPath)))"
            CopyToOutputDirectory="PreserveNewest"
            CopyToPublishDirectory="PreserveNewest" />
      <UpToDateCheckInput Include="@(_SharpPersistenceMigrationAssets)" Set="SharpPersistenceMigrations" />
    </ItemGroup>
  </Target>
</Project>
