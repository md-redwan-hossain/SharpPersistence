<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>db-migrator</ToolCommandName>
        <PackageId>SharpPersistence.Migrator.Cli</PackageId>
        <Version>1.0.0</Version>
        <Title>SharpPersistence.Migrator.Cli</Title>
        <Authors>Md. Redwan Hossain</Authors>
        <Copyright>Copyright (c) Md. Redwan Hossain</Copyright>
        <PackageProjectUrl>https://github.com/md-redwan-hossain/SharpPersistence</PackageProjectUrl>
        <PackageIcon>logo.png</PackageIcon>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/md-redwan-hossain/SharpPersistence</RepositoryUrl>
        <PackageTags>dotnet-tool cli sql database migration postgresql oracle</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <NoWarn>CS1591</NoWarn>
        <Description>CLI tool (db-migrator) for SharpPersistence.Migrator schema diffing, idempotent SQL migration generation, drift verification, and execution.</Description>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="SharpPersistence.Migrator.Tests" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
        <PackageReference Include="Spectre.Console.Cli" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\logo.png">
            <Pack>True</Pack>
            <PackagePath>.</PackagePath>
            <Link>logo.png</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <Link>README.md</Link>
            <PackagePath>.</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Ui\index.html" LogicalName="SharpPersistence.Migrator.Cli.Ui.index.html" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SharpPersistence.Migrator\SharpPersistence.Migrator.csproj" />
    </ItemGroup>

</Project>
