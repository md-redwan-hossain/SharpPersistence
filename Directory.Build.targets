<Project>
    <ItemGroup Condition="'$(IsPackable)' != 'false' And '$(IsTestProject)' != 'true' And !$(MSBuildProjectDirectory.Contains('Samples'))">
        <None Include="$(MSBuildThisFileDirectory)logo.png"
              Pack="true"
              PackagePath="."
              Link="logo.png"
              Visible="false" />
        <None Include="$(MSBuildThisFileDirectory)README.md"
              Pack="true"
              PackagePath="."
              Link="README.md"
              Visible="false" />
    </ItemGroup>
</Project>
